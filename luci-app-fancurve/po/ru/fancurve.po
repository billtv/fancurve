msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "Fan Control"
msgstr "Управление вентилятором"

msgid "Set a motherboard-style fan curve by dragging control points. Fan duty is interpolated between the points."
msgstr "Задайте кривую вентилятора как в BIOS: перетащите точки, скорость интерполируется между ними."

msgid "Settings"
msgstr "Настройки"

msgid "Enable"
msgstr "Включить"

msgid "Run the controller with the curve below."
msgstr "Запустить контроллер с кривой ниже."

msgid "Fan Curve"
msgstr "Кривая вентилятора"

msgid "Hardware"
msgstr "Оборудование"

msgid "Temperature / speed curve"
msgstr "Кривая температуры и скорости"

msgid "Thermal File"
msgstr "Файл температуры"

msgid "Fan File"
msgstr "Файл управления вентилятором"

msgid "Fan Speed File"
msgstr "Файл скорости вентилятора"

msgid "Max Speed"
msgstr "Максимальная скорость"

msgid "PWM value that corresponds to 100% on the curve."
msgstr "Значение PWM, соответствующее 100% на кривой."

msgid "Temperature divisor"
msgstr "Делитель температуры"

msgid "Linux thermal sysfs is usually millidegrees, so 1000. Use 1 if the sensor already reports °C."
msgstr "В sysfs температура обычно в миллиградусах, поэтому 1000. Укажите 1, если датчик уже отдаёт °C."

msgid "Add point"
msgstr "Добавить точку"

msgid "Remove point"
msgstr "Удалить точку"

msgid "Restore default"
msgstr "Сбросить"

msgid "Point %d"
msgstr "Точка %d"

msgid "Current temperature: %s °C"
msgstr "Текущая температура: %s °C"

msgid "Curve target: %s%%"
msgstr "Цель кривой: %s%%"

msgid "Target PWM: %s"
msgstr "Целевой PWM: %s"

msgid "Actual PWM: %s"
msgstr "Фактический PWM: %s"

msgid "Drag the points, then click Save & Apply."
msgstr "Перетащите точки, затем нажмите «Сохранить и применить»."

msgid "Horizontal axis is temperature, vertical axis is fan duty. Adjacent points are connected with straight lines, same as a motherboard fan curve. Click Save & Apply to write the curve to the controller."
msgstr "Горизонталь — температура, вертикаль — скважность. Соседние точки соединяются прямыми, как кривая вентилятора в BIOS. Нажмите «Сохранить и применить», чтобы записать кривую в контроллер."

msgid "At most 8 control points can be used."
msgstr "Можно использовать не более 8 точек."

msgid "At least two control points are required."
msgstr "Нужны как минимум две точки."

msgid "Use 2 to 8 points as temperature:percent, for example 40:0,55:25,70:50,85:80,100:100."
msgstr "Используйте 2–8 точек в формате температура:процент, например 40:0,55:25,70:50,85:80,100:100."

msgid "Temperatures must increase by at least 2 °C between points."
msgstr "Температура соседних точек должна расти минимум на 2 °C."

msgid "Fan curve applied."
msgstr "Кривая вентилятора применена."

msgid "Failed to apply fan curve: %s"
msgstr "Не удалось применить кривую вентилятора: %s"

msgid "Current speed:"
msgstr "Текущая скорость:"

msgid "Current temperature:"
msgstr "Текущая температура:"
